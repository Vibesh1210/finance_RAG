# Copy to .env and fill in. .env is gitignored and never committed.

# Gemini API (generation from Phase 5; extraction assists from Phase 2)
# Free key from https://aistudio.google.com — the free tier covers this project
# (DECISIONS.md #8: zero-cost LLM policy).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tiingo (market data, Phase 2) — free registration
TIINGO_API_KEY=

# EDGAR fair-access REQUIRES a contact email in the User-Agent (design_us.md §3.1).
# The Phase 0 gate fails if this is missing or has no '@'.
SEC_EDGAR_USER_AGENT=US-rag/0.1 (your-email@example.com)

# Local docker-compose database (host port 5433 — see docker-compose.yml comment)
DATABASE_URL=postgresql://usrag:usrag@localhost:5433/usrag
